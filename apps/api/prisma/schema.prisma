generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique @db.VarChar(32)
  passwordHash String
  role         UserRole
  isActive     Boolean       @default(true)
  authVersion  Int           @default(0)
  createdAt    DateTime      @default(now()) @db.Timestamp(3)
  updatedAt    DateTime      @updatedAt @db.Timestamp(3)
  sessions     AuthSession[]
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authVersion   Int
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime?      @db.Timestamptz(3)
  revokedAt     DateTime?      @db.Timestamptz(3)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @db.Uuid
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash  String      @unique @db.VarChar(64)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime?   @db.Timestamptz(3)
  consumedAt DateTime?   @db.Timestamptz(3)

  @@index([sessionId])
  @@index([expiresAt])
}

// ==========================================
// Clinical Module (FHIR-inspired)
// ==========================================

model Patient {
  id            String         @id @default(uuid())
  rut           String         @unique
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  familyId      String?
  family        Family?        @relation(fields: [familyId], references: [id])
  encounters    Encounter[]
  prescriptions Prescription[]
  immunizations Immunization[]
  odontogram    Odontogram?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Family {
  id              String    @id @default(uuid())
  code            String    @unique
  address         String
  members         Patient[]
  socialRiskLevel Int
}

model Encounter {
  id             String          @id @default(uuid())
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  appointmentId  String?
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  professionalId String
  date           DateTime
  status         EncounterStatus
  soapSubjective String?
  soapObjective  String?
  soapAssessment String?
  soapPlan       String?

  @@index([appointmentId])
}

enum EncounterStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ==========================================
// Dental Module
// ==========================================

model Odontogram {
  id          String               @id @default(uuid())
  patientId   String               @unique
  patient     Patient              @relation(fields: [patientId], references: [id])
  teethStates Json
  version     Int                  @default(0)
  revisions   OdontogramRevision[]
  updatedAt   DateTime             @updatedAt
}

model OdontogramRevision {
  id           String     @id @default(uuid())
  odontogramId String
  odontogram   Odontogram @relation(fields: [odontogramId], references: [id], onDelete: Restrict)
  version      Int
  teethStates  Json
  createdAt    DateTime   @default(now())

  @@unique([odontogramId, version])
}

// ==========================================
// Scheduling Module
// ==========================================

model Appointment {
  id             String            @id @default(uuid())
  patientId      String
  professionalId String
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus
  encounters     Encounter[]

  @@unique([professionalId, startTime, endTime])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ==========================================
// Pharmacy & Logistics Module
// ==========================================

model Medication {
  id              String             @id @default(uuid())
  code            String             @unique
  name            String
  activePrinciple String
  batches         Batch[]
  prescriptions   PrescriptionItem[]
}

model Batch {
  id                    String                             @id @default(uuid())
  medicationId          String
  medication            Medication                         @relation(fields: [medicationId], references: [id])
  lotNumber             String
  expirationDate        DateTime
  stock                 Int
  createdAt             DateTime                           @default(now())
  dispensingAllocations PrescriptionDispensingAllocation[]
}

model Prescription {
  id          String                   @id @default(uuid())
  patientId   String
  patient     Patient                  @relation(fields: [patientId], references: [id])
  date        DateTime                 @default(now())
  items       PrescriptionItem[]
  status      PrescriptionStatus
  dispensings PrescriptionDispensing[]
}

model PrescriptionItem {
  id                    String                             @id @default(uuid())
  prescriptionId        String
  prescription          Prescription                       @relation(fields: [prescriptionId], references: [id])
  medicationId          String
  medication            Medication                         @relation(fields: [medicationId], references: [id])
  quantity              Int
  dispensingAllocations PrescriptionDispensingAllocation[]
}

model PrescriptionDispensing {
  id             String                             @id @default(uuid())
  prescriptionId String
  prescription   Prescription                       @relation(fields: [prescriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dispensedAt    DateTime                           @default(now())
  allocations    PrescriptionDispensingAllocation[]

  @@index([prescriptionId, dispensedAt])
}

model PrescriptionDispensingAllocation {
  id                 String                 @id @default(uuid())
  dispensingId       String
  dispensing         PrescriptionDispensing @relation(fields: [dispensingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  prescriptionItemId String
  prescriptionItem   PrescriptionItem       @relation(fields: [prescriptionItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  batchId            String
  batch              Batch                  @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quantity           Int

  @@unique([dispensingId, prescriptionItemId, batchId], map: "PrescriptionDispensingAllocation_dispensing_item_batch_key")
  @@index([prescriptionItemId])
  @@index([batchId])
}

enum PrescriptionStatus {
  ISSUED
  DISPENSED
  CANCELLED
}

// ==========================================
// Immunization Module
// ==========================================

model Immunization {
  id               String   @id @default(uuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])
  vaccineCode      String
  dateAdministered DateTime
  payloadRNI       Json?
}
